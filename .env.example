# EquiRisk Health Assistant Configuration

# Set your Google Gemini API key to activate generative responses:
# Obtain your free API key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key

# LLM Provider: 'gemini' (default), 'groq', 'openai', or 'ollama'
LLM_PROVIDER=gemini
